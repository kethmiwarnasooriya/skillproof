# Copy to .env (same folder) and fill in real values. .env is git-ignored.
# Every variable can also be set as a normal environment variable, which takes precedence.

# Required: Base64-encoded HMAC key, at least 32 bytes. Generate with: openssl rand -base64 64
JWT_SECRET=
# Optional: token lifetime in milliseconds (default 86400000 = 24h)
# JWT_EXPIRATION_MS=86400000

# Optional: defaults point at a local Postgres
# DB_URL=jdbc:postgresql://localhost:5432/skillproof_db
# DB_USERNAME=postgres
# Required
DB_PASSWORD=
